+/// The message the system has for an error code, from FormatMessageA. This avoids
+/// the binary needing the name of every code.
+const SystemMessage = struct {
+    source: union(enum) {
+        /// the system's messages, which have the Win32 errors
+        system,
+        /// a module's message table, ntdll's has the NTSTATUS codes
+        module: HMODULE,
+    },
+    code: u32,
+
+    pub fn format(m: SystemMessage, w: *std.Io.Writer) std.Io.Writer.Error!void {
+        var buf: [300]u8 = undefined;
+        const flags: DWORD, const module: ?HMODULE = switch (m.source) {
+            .system => .{ FORMAT_MESSAGE_FROM_SYSTEM, null },
+            .module => |module| .{ FORMAT_MESSAGE_FROM_HMODULE, module },
+        };
+        const len = FormatMessageA(flags | FORMAT_MESSAGE_IGNORE_INSERTS, module, m.code, 0, &buf, buf.len, null);
+        if (len == 0) return w.writeAll("no message");
+        // NTSTATUS messages are often multiple lines
+        var it = std.mem.tokenizeAny(u8, buf[0..len], "\r\n");
+        if (it.next()) |first| try w.writeAll(first);
+        while (it.next()) |line| try w.print(" {s}", .{line});
+        // messages can be arbitrarily long
+        if (len + 1 >= buf.len) try w.writeAll("...");
+    }
+};
+const FORMAT_MESSAGE_IGNORE_INSERTS = 0x200;
+const FORMAT_MESSAGE_FROM_HMODULE = 0x800;
+const FORMAT_MESSAGE_FROM_SYSTEM = 0x1000;
+extern "kernel32" fn FormatMessageA(
+    dwFlags: DWORD,
+    lpSource: ?*const anyopaque,
+    dwMessageId: DWORD,
+    dwLanguageId: DWORD,
+    lpBuffer: [*]u8,
+    nSize: DWORD,
+    Arguments: ?*anyopaque,
+) callconv(.winapi) DWORD;
+extern "kernel32" fn GetModuleHandleA(lpModuleName: [*:0]const u8) callconv(.winapi) ?HMODULE;
+
 /// Call this when you made a windows DLL call or something that does SetLastError
